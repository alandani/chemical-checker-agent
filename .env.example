# Copy to .env and fill in.

# Claude API (price extraction from vendor pages, route ranking, report summary).
# Without it the app still runs on cached/sample data with a template summary.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REASONING=claude-sonnet-5-5
CLAUDE_MODEL_EXTRACTION=claude-haiku-5-5

# Database: SQLite by default; docker-compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://chem:chem@localhost:5432/chemchecker

# Pricing
BASE_CURRENCY=AUD
OFFER_MAX_AGE_DAYS=7
ENABLE_LIVE_SCRAPING=true
SCRAPE_TIMEOUT_S=30
# Vendor keys from scrapers/vendors.py (verify each search URL first)
ENABLED_VENDORS=bldpharm,enamine,medchemexpress

# Route prediction (optional, see README)
# AIZYNTH_CONFIG=data/aizynth/config.yml   # set automatically in docker-compose
AIZYNTH_TIME_LIMIT_S=90

# Literature references for compounds with no recorded route (Valency, https://valency.io).
# Token is on the Settings page of the Valency app. Leave blank to skip the literature step.
VALENCY_TOKEN=
# VALENCY_URL=https://mcp.valency.io/
